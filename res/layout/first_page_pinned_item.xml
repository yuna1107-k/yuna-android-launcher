<?xml version="1.0" encoding="utf-8"?>
<!-- Item pinned to the first home page: glance panel + search bar. -->
<com.android.launcher3.custom.FirstPagePinnedView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/search_container_workspace"
    android:layout_width="match_parent"
    android:layout_height="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.android.launcher3.custom.GlanceView
            android:id="@+id/glance_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/first_page_search_bar"
            layout="@layout/search_container_workspace"
            android:layout_width="match_parent"
            android:layout_height="56dp" />
    </LinearLayout>
</com.android.launcher3.custom.FirstPagePinnedView>
